# All domain data and AI calls use the designated Databricks workspace.
DATABRICKS_HOST=https://dbc-85372395-9d08.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=bccde8ce8d366533
DATABRICKS_APP_TABLE=workspace.msl_demo.app_state
DATABRICKS_MODEL_ENDPOINT=databricks-gpt-oss-20b

# Local Node development: supported CLI OAuth profile. No token goes into browser code.
DATABRICKS_AUTH_PROFILE=msl-canonical
# Hosted Node server: configure a restricted server credential in your secret manager.
# DATABRICKS_TOKEN=

APP_ORIGIN=http://localhost:8081
# Generate secrets and synthetic accounts using scripts/configure-databricks-local.ts.
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ACCOUNTS_JSON=[]
LOVABLE_CRON_SECRET=replace-with-a-long-random-secret

# Newsletter generation: verified Databricks-hosted exact-claim selection only.
NEWSLETTER_MODEL_ENDPOINT=databricks-gpt-oss-20b
# Default is a durable no-send preview. No configured provider implicitly authorizes recipients.
EMAIL_MODE=preview
EMAIL_SEND_ENABLED=false
EMAIL_RECIPIENTS_JSON=[]
EMAIL_UNSUBSCRIBE_SECRET=
# EMAIL_UNSUBSCRIBE_SECRET_PREVIOUS=
# Gmail sender OAuth (server secret manager; never browser variables).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# Google-signed Pub/Sub push notifications; provision Google resources separately.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# An explicitly designated human identity may attest Gmail delivery reports.
EMAIL_DELIVERY_REVIEWER=

# Research writer/reviewer role; configure actual human identity through the trusted operator.
KB_NAMESPACE=workspace.msl_demo
KB_AUTHORIZED_REVIEWERS=
KB_REVIEWER_REGISTRY_JSON=[]
# Offline preview artifact directory, never canonical content.
# NEWSLETTER_PREVIEW_DIR=artifacts/newsletter-preview
